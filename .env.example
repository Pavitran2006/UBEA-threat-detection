# ==============================================================================
# UEBA Threat Detection Platform - Environment Configuration Example
# Copy this file to .env and configure values appropriate for your environment.
# Never commit the populated .env file to Git or version control!
# ==============================================================================

# Core Application Settings
ENVIRONMENT=development                # 'development' or 'production'
PORT=8000                              # Application listening port
HOST=0.0.0.0
SECRET_KEY=change-this-to-a-very-strong-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Telemetry Simulator
# Set to 'false' for production (default). Set to 'true' to generate demonstration telemetry.
ENABLE_SIMULATION=false

# Database Configuration Options
# OPTION 1: Managed Database (e.g. Render PostgreSQL, Supabase, Neon)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# OPTION 2: Local / Hosted MySQL
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=ueba_system

# OPTION 3: SQLite (Local development / testing fallback)
# DB_TYPE=sqlite
# DATABASE_URL=sqlite:///ueba.db

# Security & OTP Configuration
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
SESSION_IDLE_TIMEOUT_MINUTES=30
ACCOUNT_LOCK_MINUTES=15

# SMTP Email Configuration (For Password Reset / OTP Delivery)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# External Geolocation / Maps (Optional)
GOOGLE_MAPS_API_KEY=
